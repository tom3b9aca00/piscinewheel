# Copie ce fichier en .env et remplis-le.

# Fichier facultatif : sans .env, le serveur démarre en mode "simple".
# Fournisseur de connexion :
#   simple = on tape n'importe quel login, sans mot de passe (par défaut)
#   42next = vraie connexion 42 Next (Keycloak)  — nécessite FT_CLIENT_ID ci-dessous
#   intra  = ancienne intra (api.intra.42.fr)
AUTH_PROVIDER=simple

# Identifiants du client OpenID Connect fournis par l'équipe 42 Next (staff / bocal).
# FT_CLIENT_SECRET peut rester vide si le client est "public" (PKCE).
FT_CLIENT_ID=
FT_CLIENT_SECRET=
# Doit être EXACTEMENT une des "Valid redirect URIs" du client
FT_REDIRECT_URI=http://localhost:3000/callback
PORT=3000

# Realm Keycloak de 42 Next (normalement rien à changer)
OIDC_ISSUER=https://keycloak.prod.42.tech/realms/42Next

# Facultatif : n'accepter que certains domaines d'e-mail (ex. student.42marseille.com), séparés par des virgules
ALLOWED_EMAIL_DOMAINS=
# Utilisé seulement avec AUTH_PROVIDER=intra
ALLOWED_CAMPUS=Marseille

# Logins autorisés à remettre les scores à zéro (pas en mode simple), séparés par des virgules
ADMINS=

# Stockage permanent des scores (conseillé en ligne) : base Redis gratuite sur https://upstash.com
# Sans ces deux valeurs, les scores sont gardés dans data/state.json.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
